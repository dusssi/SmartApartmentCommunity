<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_2xl"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/space_2xl"
        android:paddingBottom="@dimen/space_xl">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_app_logo_transparent" />

        <TextView
            android:id="@+id/splashCommunityOverline"
            style="@style/TextAppearance.App.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:text="@string/community_name"
            android:textColor="@color/secondary" />

        <TextView
            android:id="@+id/splashTitle"
            style="@style/TextAppearance.App.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xs"
            android:gravity="center"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/splashTagline"
            style="@style/TextAppearance.App.BodySecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/app_tagline" />

        <FrameLayout
            android:id="@+id/splashAccentTrack"
            android:layout_width="88dp"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_splash_accent_track"
            android:clipChildren="true">

            <View
                android:id="@+id/splashAccentBar"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_splash_accent_bar" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
