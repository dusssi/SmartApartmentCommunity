<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard quick-action tile — Stitch-inspired: rounded card, icon container, clear hierarchy -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/actionTileCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/outline"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_md">

        <FrameLayout
            android:layout_width="@dimen/icon_container"
            android:layout_height="@dimen/icon_container"
            android:background="@drawable/action_icon_background">

            <ImageView
                android:id="@+id/actionIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/actionTitle"
            style="@style/TextAppearance.App.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/actionCaption"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xs"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.3" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
