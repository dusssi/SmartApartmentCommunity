<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/sectionTitle"
        style="@style/TextAppearance.App.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityHeading="true" />

    <TextView
        android:id="@+id/sectionAction"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_2xs"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textColor="@color/primary"
        android:visibility="gone" />
</LinearLayout>
