<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feedbackDialogCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/elevation_card_hover"
    app:strokeColor="@color/outline"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_lg">

        <FrameLayout
            android:id="@+id/feedbackIconBadge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_feedback_success_circle">

            <ImageView
                android:id="@+id/feedbackIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check" />
        </FrameLayout>

        <TextView
            android:id="@+id/feedbackTitle"
            style="@style/TextAppearance.App.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/feedbackMessage"
            style="@style/TextAppearance.App.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:lineSpacingMultiplier="1.35" />

        <LinearLayout
            android:id="@+id/feedbackActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feedbackSecondaryButton"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_min"
                android:text="@string/action_cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:visibility="gone"
                app:strokeColor="@color/outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feedbackPrimaryButton"
                style="@style/Widget.App.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_min"
                android:text="@string/action_continue"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
