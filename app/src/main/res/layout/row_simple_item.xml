<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable list row: title, supporting text, metadata and a status chip. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/outline"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_sm">

        <View
            android:id="@+id/rowMarker"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="@drawable/row_marker" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowTitle"
                style="@style/TextAppearance.App.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rowSubtitle"
                style="@style/TextAppearance.App.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/rowMetadata"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowBadge"
            style="@style/TextAppearance.App.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="@dimen/space_xs"
            android:paddingTop="@dimen/space_2xs"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="@dimen/space_2xs"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
