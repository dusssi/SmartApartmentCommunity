<?xml version="1.0" encoding="utf-8"?>
<!--
  Smart Community design tokens — Stitch-inspired palette.
  Primary source: attached Stitch_UI_Reference_for_Arena_AI.pdf (not found in repo, so inferred from brief).
  Brief states: clean modern apartment aesthetic, blue primary, teal accents, neutral backgrounds,
  rounded cards, clear typography, consistent spacing.

  This palette replaces the provisional emerald direction with a blue/teal system that matches
  the Stitch reference description.
-->
<resources>
    <!-- Brand — Blue primary from Stitch brief -->
    <color name="primary">#2563EB</color> <!-- Blue 600 - primary actions, focused states -->
    <color name="primary_dark">#1E40AF</color> <!-- Blue 800 - headings on brand, dark variant -->
    <color name="primary_light">#DBEAFE</color> <!-- Blue 100 - icon containers, badges, selected -->
    <color name="primary_ripple">#1F2563EB</color> <!-- 12% ripple -->
    <color name="primary_container">#EFF6FF</color> <!-- Blue 50 - subtle containers -->

    <!-- Secondary — Teal accent -->
    <color name="secondary">#0D9488</color> <!-- Teal 600 - accent, secondary actions -->
    <color name="secondary_light">#CCFBF1</color> <!-- Teal 100 - accent backgrounds -->
    <color name="secondary_container">#F0FDFA</color> <!-- Teal 50 -->
    <color name="secondary_dark">#0F766E</color>

    <!-- Surfaces — neutral backgrounds -->
    <color name="background">#F8FAFC</color> <!-- Slate 50 - screen background -->
    <color name="surface">#FFFFFF</color> <!-- Cards, inputs, bottom nav -->
    <color name="surface_variant">#F1F5F9</color> <!-- Slate 100 - grouped areas -->
    <color name="surface_container">#FFFFFF</color>
    <color name="outline">#E2E8F0</color> <!-- Slate 200 - hairline borders -->
    <color name="outline_strong">#94A3B8</color> <!-- Slate 400 - field borders, 3.5:1 on white -->
    <color name="outline_variant">#CBD5E1</color>

    <!-- Text — slate hierarchy for readability -->
    <color name="text_primary">#0F172A</color> <!-- Slate 900 - headings, body -->
    <color name="text_secondary">#475569</color> <!-- Slate 600 - supporting -->
    <color name="text_muted">#94A3B8</color> <!-- Slate 400 - metadata, placeholders -->
    <color name="text_on_primary">#FFFFFF</color>

    <!-- Semantic -->
    <color name="success">#16A34A</color>
    <color name="success_container">#DCFCE7</color>
    <color name="warning">#D97706</color>
    <color name="warning_container">#FEF3C7</color>
    <color name="danger">#DC2626</color>
    <color name="danger_container">#FEE2E2</color>
    <color name="info">#0284C7</color>
    <color name="info_container">#E0F2FE</color>

    <!-- Operations workspace — restrained navy/indigo accents with accessible light surfaces -->
    <color name="operations_navy">#102A43</color>
    <color name="operations_indigo">#3730A3</color>
    <color name="operations_on_navy_secondary">#D9E2EC</color>
    <color name="operations_outcome_surface">#EEF2FF</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- Legacy compatibility -->
    <color name="primary_variant">#1D4ED8</color>
</resources>
