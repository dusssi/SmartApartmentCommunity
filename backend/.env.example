# Copy to .env locally and supply unique secrets. .env is ignored by Git.
DB_URL=jdbc:mysql://127.0.0.1:3306/smart_community?useSSL=true&requireSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_NAME=smart_community
DB_USERNAME=smart_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_PORT=3306
JWT_SECRET_BASE64=
JWT_ISSUER=smart-community-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
ALLOW_REGISTRATION=true
PORT=8080
